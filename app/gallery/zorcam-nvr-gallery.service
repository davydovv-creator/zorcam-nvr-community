[Unit]
Description=Zorcam gallery (port 80)
After=network.target

[Service]
# no EnvironmentFile: app.py reads the camera passwords from secrets.env itself, when it needs them
AmbientCapabilities=CAP_NET_BIND_SERVICE
Type=simple
ExecStart=/usr/bin/python3 /opt/zorcam-nvr/gallery/app.py
Restart=always
RestartSec=2
# app.py sends WATCHDOG=1 while it answers /healthz; if it hangs, systemd restarts it
WatchdogSec=90
NotifyAccess=main
# its own system user without sudo or a login; the program in /opt/zorcam-nvr is read-only for it, it writes only
# /var/lib/zorcam-nvr (settings, recordings) and /dev/shm/zorcam_*
User=zorcam-nvr
Group=zorcam-nvr
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# no new privileges or kernel changes, and only what the service uses: a compromised process gets less to work with.
# Files of the service are private to the group (the recordings are read by admin through the group zorcam-nvr)
UMask=0027
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
WorkingDirectory=/opt/zorcam-nvr/gallery
# limits: a runaway process is restarted instead of freezing the whole Pi (1 GB RAM, SSH must stay reachable)
MemoryHigh=200M
MemoryMax=250M
MemorySwapMax=0
CPUQuota=200%
CPUWeight=50

[Install]
WantedBy=multi-user.target
